{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saturn-devouring",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",
  "services": [{ "binding": "LEGACY_API", "service": "charon" }],
  // Optional TURN fallback: set TURN_KEY_ID and TURN_KEY_TOKEN to enable it.
  // Direct WebRTC uses the built-in STUN servers without these secrets.
  // Serve the BUILT site, not the repo. Pointing this at "." shipped ~60 raw ES
  // modules with every comment and blank line in them; `npm run build:site`
  // bundles and minifies the game's graph into dist/site and mirrors everything
  // else verbatim. Measured on the game path: 2,078 KB gzipped -> 1,765 KB, and
  // a few dozen fewer round-trips.
  //
  // Run `npm run build:site` before `npm run deploy` — `npm run deploy` does it
  // for you. dist/ is gitignored, so a clean checkout must build first.
  "assets": { "directory": "./dist/site", "binding": "ASSETS" }
}
